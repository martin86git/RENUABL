# Copy to .env.local for local overrides. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Shows the "sample data" banner and blocks search indexing. Leave unset (on) until launch.
# NEXT_PUBLIC_PREVIEW_MODE=false

# HubSpot Meetings link for the 15-minute confirmation call. Customers book it themselves on the confirmation screen.
# NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=https://meetings.hubspot.com/your-team/confirmation-call

# Links in text messages (defaults to Vercel's production domain)
SITE_URL=
# Text messages via Twilio (server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe (dashboard.stripe.com/test/apikeys). Keep the secret key out of code and never prefix it with NEXT_PUBLIC_.
# Secret key (sk_test_… / sk_live_…), server-side only
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) for https://<your-site>/api/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_… / pk_live_…, same mode as the secret key) for the embedded deposit form. Safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Database (Neon Postgres): partner accounts, jobs, offers, sign-in sessions
DATABASE_URL=
# RENUABL staff who can approve partners at /admin (comma separated)
ADMIN_EMAILS=
# Protects the daily offers cron (/api/cron/offers)
CRON_SECRET=
