# Copy to .env.local for local overrides. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Shows the "sample data" banner and blocks search indexing. Leave unset (on) until launch.
# NEXT_PUBLIC_PREVIEW_MODE=false

# HubSpot Meetings link for the 15-minute confirmation call. Customers book it themselves on the confirmation screen.
# NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=https://meetings.hubspot.com/your-team/confirmation-call
